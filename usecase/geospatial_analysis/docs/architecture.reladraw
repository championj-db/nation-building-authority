// Geospatial analysis: public data in, synthetic households placed, H3-pruned analysis,
// governed aggregates out to the Spatial Service Planner app.
diagram  title: "Geospatial analysis - access to essential services"  theme: light  background: #F9F7F4

default node  border: #1B3139  text: (color: #1B3139)
default leaf  fill: #FFFFFF
default container  fill: #EEEDE9  border: #90A5B1
default edge  line: #5A6F77  text: (color: #1B3139, size: small)

style  dim     text: (size: small, color: #5A6F77)
style  ext     fill: #DCE0E2                        border: #618794
style  store   fill: #FFF1EF                        border: #FF3621  badge: database
style  dbx     fill: #1B3139                        border: #1B3139  text: (color: #FFFFFF)
style  ondark  text: (size: small, color: #DCE0E2)
style  table   badge: database
style  bronze  fill: #F6E3D3                        border: #B5651D
style  silver  fill: #E8ECEF                        border: #8A9BA8
style  gold    fill: #FBF1D0                        border: #C9A227

// Public sources, fetched at run time
node  src       "Public sources (CC BY 4.0)" (inside top)                                layout: column (gap: tight, widths: match)  style: ext
node  src.asgs  "ABS ASGS 2021 / [dim]SA1-SA4, LGA, RA, state[/dim]"                     style: ext
node  src.erp   "ABS Data API / [dim]ERP by SA2 and age[/dim]"                           style: ext
node  src.svc   "Digital Atlas + GA / [dim]hospitals, UCCs, aged care, ambulance[/dim]"  style: ext

// Lakeflow Job, serverless
node  job  "Lakeflow Job (serverless)" (inside top)  layout: row (gap: normal, align-children: center)  right of src (gap: 20)

node  job.bronze      "Bronze" (inside top)                                   layout: column (gap: tight, widths: match)  style: bronze
node  job.bronze.vol  "landing volume / [dim]raw GeoJSON + CSV[/dim]"         style: table
node  job.bronze.tbl  "bronze_boundary / [dim]bronze_erp, bronze_site[/dim]"  style: table

node  job.silver      "Silver" (inside top)                                     layout: column (gap: tight, widths: match)  style: silver
node  job.silver.geo  "silver_boundary / [dim]ST_MakeValid, WKB[/dim]"          style: table
node  job.silver.hh   "silver_household / [dim]dbldatagen + ST_Contains[/dim]"  style: table
node  job.silver.loc  "containment / [dim]H3 chips, LGA + RA[/dim]"             style: table
node  job.silver.acc  "proximity / [dim]H3-pruned, ST_DistanceSphere[/dim]"     style: table

node  job.gold         "Gold" (inside top)                                  layout: column (gap: tight, widths: match)  style: gold
node  job.gold.region  "gold_region / [dim]map-ready geometry[/dim]"        style: table
node  job.gold.band    "gold_access_band / [dim]1 km distance bands[/dim]"  style: table
node  job.gold.cell    "gold_cell_access / [dim]H3 res 8 cells[/dim]"       style: table
node  job.gold.site    "gold_service_site / [dim]catchments[/dim]"          style: table

// Serving
node  app      "Spatial Service Planner / [ondark]Databricks App, AppKit[/ondark]"                    style: dbx    right of job (gap: 14)  even with job.gold
node  officer  "Officer"                                                                              icon: laptop  right of app (gap: 10)
node  writes   "app_review_note / app_saved_view, app_brief"                                          style: store  below app (gap: 10)
node  uc       "Unity Catalog grants, OBO, / small-count suppression in SQL" (size: small, wrap: 26)  shape: none   above app (gap: tight)

edge  src -> job.bronze         "fetch, / cache fallback"  from: right  to: left  line: (path: square)
edge  job.bronze -> job.silver
edge  job.silver -> job.gold
edge  job.gold -> app           "SQL warehouse"
edge  app <-> officer
edge  app -> writes             "append-only, as officer"
