DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_CATALOG=<catalog>
DATABRICKS_SCHEMA=<schema-written-by-the-pipeline>
DATABRICKS_VOLUME_FILES=/Volumes/<catalog>/<schema>/documents
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=nba-document-workbench
# Optional: Ask (Genie) and Ingest documents.
# DATABRICKS_GENIE_SPACE_ID=<genie-space-id>
# DATABRICKS_JOB_ID=<arrivals-job-id>
# Optional: decisions. Leave unset to run read-only.
# Deploy the app once first so its service principal creates and owns the daw schema.
# LAKEBASE_ENDPOINT=projects/<project-id>/branches/production/endpoints/primary
# PGHOST=<endpoint-host>
# PGDATABASE=databricks_postgres
# PGSSLMODE=require
