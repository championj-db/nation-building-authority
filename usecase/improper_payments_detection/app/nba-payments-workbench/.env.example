DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_CATALOG=<catalog>
DATABRICKS_SCHEMA=<schema-written-by-the-pipeline>
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=nba-payments-workbench
# Optional: outcome capture. Leave unset to run the queue read-only.
# Deploy the app once first so its service principal creates and owns the ipw schema.
# LAKEBASE_ENDPOINT=projects/<project-id>/branches/production/endpoints/<endpoint-id>
# PGHOST=<endpoint-host>
# PGDATABASE=databricks_postgres
# PGSSLMODE=require
